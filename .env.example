# App Configuration
APP_NAME="AI-Powered Clinic Automation Platform"
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
TIMEZONE="Asia/Kolkata"

# Security & JWT Authentication
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# SQLite for local development/testing: sqlite+aiosqlite:///./clinic_platform.db
# PostgreSQL for production: postgresql+psycopg2://postgres:postgres@localhost:5432/clinic_db
DATABASE_URL="sqlite:///./clinic_platform.db"

# Clinic Metadata
CLINIC_NAME="City Care Health Clinic"
CLINIC_ADDRESS="123 MG Road, Bangalore - 560001"
CLINIC_PHONE="+91-98765-43210"
CLINIC_TIMINGS="Mon–Sat: 9:00 AM – 8:00 PM | Sun: 10:00 AM – 2:00 PM"
CLINIC_FEES_SUMMARY="₹500 (General) | ₹800 (Specialist)"

# WhatsApp Provider Configuration (meta / twilio / mock)
WHATSAPP_PROVIDER="meta"

# WhatsApp Cloud API (Meta Graph API)
META_WA_PHONE_NUMBER_ID="your_meta_phone_number_id"
META_WA_ACCESS_TOKEN="your_meta_system_user_token"
META_WA_VERIFY_TOKEN="your_custom_webhook_verification_token"
META_WA_APP_SECRET="your_meta_app_secret_for_signature_verification"

# Twilio WhatsApp Configuration (Alternative / Fallback)
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"

# LLM Configuration (OpenAI or Gemini)
LLM_PROVIDER="openai"
OPENAI_API_KEY="your_openai_api_key"
OPENAI_MODEL="gpt-4o-mini"
GEMINI_API_KEY=""

# Background Worker & Reminders
REMINDER_INTERVAL_MINUTES=15
REMINDER_24H_HOURS_BEFORE=24
REMINDER_2H_HOURS_BEFORE=2

# Legacy Google Sheets Integration (Optional fallback)
GOOGLE_SHEET_ID=""
GOOGLE_CREDENTIALS_PATH="credentials.json"
